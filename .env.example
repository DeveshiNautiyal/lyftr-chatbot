# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=replace-with-key-1,replace-with-key-2
# Any LiteLLM model name that matches your keys' provider
MODEL=gemini/gemini-3-flash-preview
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
ENABLE_FAILURE_SIMULATION=true
# Optional
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
CACHE_ENABLED=true
REQUEST_TIMEOUT=30
# Frontend build-time: public URL of the backend
VITE_API_URL=http://localhost:8000
TEMPERATURE=1.0
